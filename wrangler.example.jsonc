// Cloudflare Workers deploy config — TEMPLATE.
// Copy to wrangler.jsonc (gitignored) and fill in your production URL.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vehicle-log-viewer",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "VITE_APP_URL": "https://<worker>.<your-subdomain>.workers.dev",
    "VITE_APP_NAME": "Vehicle Log Viewer"
  }
}
